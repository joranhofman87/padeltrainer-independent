# Local development (Vite dev server: http://localhost:8080)
# Copy to .env and fill in ficwb values from Supabase Dashboard → Settings → API.

VITE_SUPABASE_URL=https://ficwbdrzefmblkbkomzw.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<ficwb-anon-key>
VITE_SUPABASE_PROJECT_ID=ficwbdrzefmblkbkomzw

# Optional: Playwright / E2E (defaults to http://localhost:8080)
# PLAYWRIGHT_BASE_URL=http://localhost:8080

# Server-only (Vercel API routes / cron — never use VITE_ prefix)
# CRON_SECRET=<random-secret>
# SUPABASE_SERVICE_ROLE_KEY=<ficwb-service-role-key>

# Supabase CLI / Management API (local tooling only — never commit)
# SUPABASE_ACCESS_TOKEN=sbp_...
