# Edge-function env for the LOCAL money-path E2E (scripts/db/edge-serve-local.sh reads this).
# NO SECRETS: the Mollie key is a stand-in — scripts/db/mock-mollie.mjs ignores its value and
# only the "test_" prefix matters (it flips the functions into Mollie testmode). SUPABASE_URL /
# SUPABASE_*_KEY are auto-injected by `supabase functions serve`, so they are intentionally absent.
#
# MOLLIE_API_BASE points the create-payment → webhook loop at the local mock instead of the real
# gateway. host.docker.internal = the host as seen from inside the edge-runtime container.
MOLLIE_API_KEY=test_mock
MOLLIE_API_BASE=http://host.docker.internal:54999
APP_URL=http://localhost:8080
